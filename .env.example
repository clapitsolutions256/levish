# From the new Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login (/admin/login)
ADMIN_EMAIL=admin@levish.store
ADMIN_PASSWORD=
JWT_SECRET=

# Levish's section of the shared Supabase project (never "public": that is Empulse's)
SUPABASE_SCHEMA=levish
SUPABASE_BUCKET=levish-images

# Order and password emails (Resend). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Levish <orders@levish.store>
ORDER_EMAIL_REPLY_TO=itslevishstore@gmail.com

# Levish's own Meta Pixel ID (leave empty for no tracking; never reuse another store's Pixel)
NEXT_PUBLIC_META_PIXEL_ID=
