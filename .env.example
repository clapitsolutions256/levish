# From the new Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login (/admin/login)
ADMIN_EMAIL=admin@levish.store
ADMIN_PASSWORD=
JWT_SECRET=

# Levish's section of the shared Supabase project (never "public": that is Empulse's)
SUPABASE_SCHEMA=levish
SUPABASE_BUCKET=levish-images

# Order and password emails (Resend). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Levish <orders@levish.store>
ORDER_EMAIL_REPLY_TO=itslevishstore@gmail.com
# New-order alerts for the store (comma separated for several inboxes)
ORDER_ALERT_EMAIL=itslevishstore@gmail.com

# Levish's own Meta Pixel ID (leave empty for no tracking; never reuse another store's Pixel)
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp sales agent (Meta app "Levish Sales Agent" > WhatsApp > API Setup)
# Token: temporary from API Setup for testing; a System User token for production.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret (signs every webhook call)
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value as "Verify token" in the webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# Google AI Studio key (free tier). Leave empty and the bot sends a fixed greeting.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional second Gemini model, tried when GEMINI_MODEL stays busy
GEMINI_FALLBACK_MODEL=
